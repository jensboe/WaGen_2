# Copy to .env and fill in
# Local development (SQLite):
# DATABASE_URL=file:./prisma/dev.db
#
# Netcup production (SQLite, absoluter Pfad):
# DATABASE_URL=file:/var/www/vhosts/DOMAIN/app-data/prod.db
DATABASE_URL=file:./prisma/dev.db
PORT=3000
UPLOAD_DIR=./data
# Netcup: UPLOAD_DIR=/var/www/vhosts/DOMAIN/app-data/uploads
CORS_ORIGIN=http://localhost:4200
# Netcup: CORS_ORIGIN=https://DEINE-DOMAIN.de
