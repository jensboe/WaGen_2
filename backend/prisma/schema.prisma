generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Image {
  id                   Int      @id @default(autoincrement())
  originalPath         String
  finalPath            String?
  cropX                Float?
  cropY                Float?
  cropWidth            Float?
  cropHeight           Float?
  aspectRatio          String?
  watermarkSrc         String?
  watermarkPosition    String?
  watermarkProportion  Int?
  watermarkBorder      Int?
  createdAt            DateTime @default(now())
}
