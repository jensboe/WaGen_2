generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Image {
  id                   Int      @id @default(autoincrement())
  originalPath         String
  finalPath            String?
  cropX                Float?
  cropY                Float?
  cropWidth            Float?
  cropHeight           Float?
  aspectRatio          String?
  watermarkId          Int?
  watermarkPosition    String?
  watermarkProportion  Int?
  watermarkBorder      Int?
  createdAt            DateTime @default(now())
  watermark            Watermark? @relation(fields: [watermarkId], references: [id], onDelete: SetNull)
}

model Watermark {
  id        Int      @id @default(autoincrement())
  label     String
  filePath  String
  createdAt DateTime @default(now())
  images    Image[]
}
