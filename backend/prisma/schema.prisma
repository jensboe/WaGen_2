generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Image {
  id           Int      @id @default(autoincrement())
  originalPath String
  finalPath    String?
  title        String?
  description  String?
  metadata     String?
  createdAt    DateTime @default(now())
}
