generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Image {
  id                   Int      @id @default(autoincrement())
  originalPath         String
  finalPath            String?
  cropX                Float?
  cropY                Float?
  cropWidth            Float?
  cropHeight           Float?
  aspectRatio          String?
  watermarkId          Int?
  watermarkPosition    String?
  watermarkProportion  Int?
  watermarkBorder      Int?
  createdAt            DateTime @default(now())
  watermark            Watermark? @relation(fields: [watermarkId], references: [id], onDelete: SetNull)
  redactions           ImageRedaction[]
}

model Watermark {
  id        Int      @id @default(autoincrement())
  label     String
  filePath  String
  createdAt DateTime @default(now())
  images    Image[]
}

model ImageRedaction {
  id         Int      @id @default(autoincrement())
  imageId     Int
  tool        String
  sortOrder   Int
  x           Float?
  y           Float?
  width       Float?
  height      Float?
  rotation    Float?
  brushSize   Float?
  blur        Int
  image       Image     @relation(fields: [imageId], references: [id], onDelete: Cascade)
  points      ImageRedactionPoint[]
}

model ImageRedactionPoint {
  id           Int      @id @default(autoincrement())
  redactionId  Int
  sortOrder    Int
  x            Float
  y            Float
  redaction    ImageRedaction @relation(fields: [redactionId], references: [id], onDelete: Cascade)
}
